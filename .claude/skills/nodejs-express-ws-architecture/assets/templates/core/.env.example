# HTTP API port
SERVER_PORT=5001

# Origin of the frontend, used for CORS
CLIENT_URL=http://localhost:5173

# --- Add per-layer sections below only if the corresponding template was copied in ---

# Prisma / Postgres (assets/templates/prisma/)
# DATABASE_URL=postgresql://user:password@localhost:5432/{{project-name}}

# Redis (assets/templates/redis/)
# REDIS_HOST=localhost
# REDIS_PORT=6379

# JWT auth (assets/templates/auth-jwt/)
# JWT_SECRET=
# JWT_SECRET_REFRESH=

# Real-time WebSocket layer (assets/templates/websocket/)
# SOCKET_PORT=5002
